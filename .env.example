# ============================================================
# SR ENTERPRISES CRM — PRODUCTION & DEVELOPMENT ENVIRONMENT TEMPLATE
# ============================================================
#
# Target Architecture:
# - Frontend: Vercel
# - Backend API: Oracle Cloud (Fastify + TypeScript)
# - Database: Supabase PostgreSQL
# - Object Storage: Supabase Storage (Bucket: crm-documents)
# ============================================================

# ------------------------------------------------------------
# 1. FRONTEND CONFIGURATION (Set in Vercel Project Settings)
# ------------------------------------------------------------
# Public base URL of the Oracle Cloud Backend API (e.g. https://api.yourdomain.com)
VITE_API_URL=https://api.yourdomain.com

# ------------------------------------------------------------
# 2. BACKEND SERVER (Set in Oracle Cloud Environment)
# ------------------------------------------------------------
NODE_ENV=production
PORT=4000
HOST=0.0.0.0
# Public API URL for self-referencing callbacks and health audits
API_URL=https://api.yourdomain.com
# Vercel Frontend Domain (used for strict CORS allowlist)
WEB_URL=https://your-crm.vercel.app
# Additional comma-separated origins for CORS if using custom domain or preview branches
CORS_ALLOWED_ORIGINS=https://your-crm.vercel.app,https://crm.yourdomain.com
LOG_LEVEL=info

# ------------------------------------------------------------
# 3. SUPABASE POSTGRESQL DATABASE
# ------------------------------------------------------------
# Standard Supabase PostgreSQL Connection String (Session / Transaction Pooler or Direct)
# Direct connection: postgresql://postgres:[YOUR-DB-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require
# Pooler connection: postgresql://postgres.[PROJECT-REF]:[YOUR-DB-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:[YOUR-DB-PASSWORD]@db.swdrtbdpzjcxptszskll.supabase.co:5432/postgres?sslmode=require
DB_MAX_CONNECTIONS=20
DB_IDLE_TIMEOUT_MS=30000

# ------------------------------------------------------------
# 4. SUPABASE PERSISTENT FILE STORAGE
# ------------------------------------------------------------
# Connects backend to Supabase Storage for invoices, receipts, and CRM documents
SUPABASE_URL=https://swdrtbdpzjcxptszskll.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
SUPABASE_STORAGE_BUCKET=crm-documents

# ------------------------------------------------------------
# 5. CACHE & BACKGROUND JOBS (REDIS)
# ------------------------------------------------------------
# Optional: If Redis is absent, the backend automatically uses its high-performance in-memory fallback
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------
# 6. AUTHENTICATION & SECURITY SECRETS
# ------------------------------------------------------------
# High-entropy 32+ character secrets
COOKIE_SECRET=replace_with_a_secure_random_string_of_at_least_32_characters
SESSION_SECRET=replace_with_another_secure_random_string_of_32_characters
JWT_SECRET=replace_with_a_third_secure_random_string_of_32_characters_here
SESSION_TTL_SECONDS=86400
MAX_LOGIN_ATTEMPTS=3
LOCKOUT_DURATION_MINUTES=15
# In production cross-site environments (Vercel <-> Oracle Cloud), keep 'none' for HTTPS cookies
COOKIE_SAME_SITE=none

# ------------------------------------------------------------
# 7. TRANSACTIONAL EMAIL / SMTP (PHPMailer & Nodemailer)
# ------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=srenterprises02015@gmail.com
SMTP_PASS=your_google_app_password_here
SMTP_FROM_EMAIL=srenterprises02015@gmail.com
SMTP_FROM_NAME=SR Enterprises
SUPPORT_EMAIL=srenterprises02015@gmail.com
SUPPORT_PHONE=+91 73850 59197
MOCK_MAIL=false

# ------------------------------------------------------------
# 8. WHATSAPP & EXTERNAL INTEGRATIONS
# ------------------------------------------------------------
WHATSAPP_PROVIDER=META
WHATSAPP_API_URL=https://graph.facebook.com
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=sr_enterprises_wa_verify_token

# ------------------------------------------------------------
# 9. SUPABASE PERSISTENT DB & OBJECT STORAGE
# ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://swdrtbdpzjcxptszskll.supabase.co
