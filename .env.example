# ============================================================
# SR ENTERPRISES CRM — PRODUCTION & DEVELOPMENT ENVIRONMENT TEMPLATE
# ============================================================
#
# Target Architecture:
# - Operating System: Ubuntu 24.04 LTS ARM64 (aarch64)
# - Container Model: Docker + Docker Compose (linux/arm64)
# - Reverse Proxy: Nginx (Ports 80 & 443 with TLS termination)
# - Backend API: Node.js 22 LTS + Fastify (Port 4000)
# - Database: PostgreSQL 18 (Self-managed on OCI persistent volume)
# - Cache / Queues: Redis 7 (Internal private network)
# - File Storage: Local Persistent Docker Volume (/app/storage/documents)
# ============================================================

# ------------------------------------------------------------
# 1. FRONTEND CONFIGURATION
# ------------------------------------------------------------
# Optional in production when served behind Nginx reverse proxy (defaults to same-origin)
VITE_API_URL=https://crm.yourdomain.com

# ------------------------------------------------------------
# 2. BACKEND SERVER CONFIGURATION
# ------------------------------------------------------------
NODE_ENV=production
PORT=4000
HOST=0.0.0.0
# Public domain URL for self-referencing callbacks and health audits
API_URL=https://crm.yourdomain.com
WEB_URL=https://crm.yourdomain.com
# Additional comma-separated origins for CORS allowlist
CORS_ALLOWED_ORIGINS=https://crm.yourdomain.com
LOG_LEVEL=info

# ------------------------------------------------------------
# 3. DIRECT POSTGRESQL 18 DATABASE CONFIGURATION
# ------------------------------------------------------------
# Self-managed PostgreSQL 18 running on OCI (Private Docker Network)
POSTGRES_DB=sr_enterprises_crm
POSTGRES_USER=sr_crm_user
POSTGRES_PASSWORD=replace_with_a_secure_database_password
POSTGRES_PORT=5432
DATABASE_URL=postgres://sr_crm_user:replace_with_a_secure_database_password@postgres:5432/sr_enterprises_crm
DB_MAX_CONNECTIONS=20
DB_IDLE_TIMEOUT_MS=30000

# ------------------------------------------------------------
# 4. PERSISTENT OBJECT & DOCUMENT STORAGE
# ------------------------------------------------------------
# Local filesystem path backed by persistent named volume in Docker Compose
DOCUMENT_STORAGE_PATH=/app/storage/documents

# ------------------------------------------------------------
# 5. CACHE & BACKGROUND JOBS (REDIS 7)
# ------------------------------------------------------------
# Redis 7 on internal private Docker network (never exposed publicly)
REDIS_URL=redis://redis:6379

# ------------------------------------------------------------
# 6. AUTHENTICATION & SECURITY SECRETS (HIGH ENTROPY)
# ------------------------------------------------------------
# Generate each 32+ character secret using: openssl rand -hex 32
COOKIE_SECRET=replace_with_secure_random_string_of_at_least_32_chars
SESSION_SECRET=replace_with_another_secure_random_string_of_32_chars
JWT_SECRET=replace_with_a_third_secure_random_string_of_32_chars
SESSION_TTL_SECONDS=86400
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
COOKIE_SAME_SITE=lax

# ------------------------------------------------------------
# 7. TRANSACTIONAL EMAIL / SMTP (SMTP RELAY)
# ------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=srenterprises02015@gmail.com
SMTP_PASS=replace_with_google_app_specific_password
SMTP_FROM_EMAIL=srenterprises02015@gmail.com
SMTP_FROM_NAME="SR Enterprises"
SUPPORT_EMAIL=srenterprises02015@gmail.com
SUPPORT_PHONE="+91 73850 59197"
MOCK_MAIL=false

# ------------------------------------------------------------
# 8. WHATSAPP & EXTERNAL INTEGRATIONS
# ------------------------------------------------------------
WHATSAPP_PROVIDER=META
WHATSAPP_API_URL=https://graph.facebook.com
WHATSAPP_PHONE_NUMBER_ID=replace_with_meta_phone_number_id
WHATSAPP_ACCESS_TOKEN=replace_with_meta_system_user_token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=replace_with_webhook_verify_token
