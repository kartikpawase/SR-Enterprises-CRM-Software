# ============================================================
# SR ENTERPRISES CRM — ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================
# Copy this file to .env before starting the development environment.
# In production, ensure all secrets are strongly generated and securely injected.

# --- APPLICATION ---
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
LOG_LEVEL=info

# --- DATABASE (POSTGRESQL 18) ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sr_enterprises_crm
POSTGRES_DB=sr_enterprises_crm
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
DB_MAX_CONNECTIONS=20
DB_IDLE_TIMEOUT_MS=30000

# --- CACHE & BACKGROUND JOBS (REDIS) ---
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- AUTHENTICATION & SECURITY ---
# Minimum 32-character high-entropy secret keys for production
COOKIE_SECRET=change_me_to_a_secure_random_string_of_at_least_32_characters
SESSION_SECRET=change_me_to_another_secure_random_string_of_32_characters
JWT_SECRET=change_me_to_a_third_secure_random_string_of_32_characters_here
SESSION_TTL_SECONDS=86400
MAX_LOGIN_ATTEMPTS=3
LOCKOUT_DURATION_MINUTES=15

# --- OBJECT STORAGE (S3 / CLOUDFLARE R2) ---
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=placeholder_r2_access_key
S3_SECRET_ACCESS_KEY=placeholder_r2_secret_key
S3_BUCKET=sr-enterprises-crm-documents
S3_REGION=auto
S3_PUBLIC_URL=https://documents.srenterprises.com

# --- EXTERNAL INTEGRATIONS ---
WHATSAPP_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_PHONE_NUMBER_ID=placeholder_phone_number_id
WHATSAPP_ACCESS_TOKEN=placeholder_access_token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=placeholder_webhook_verify_token

# --- OBSERVABILITY & MONITORING ---
SENTRY_DSN=

# --- GOOGLE DRIVE INTEGRATION ---
GOOGLE_DRIVE_PROJECT_ID=sr-enterprises-crm
GOOGLE_DRIVE_CLIENT_ID=269823064007-k992a9fpptovoe8jll05qud12kjmq1ma.apps.googleusercontent.com
GOOGLE_DRIVE_CLIENT_SECRET=your_oauth_client_secret_here
GOOGLE_DRIVE_FOLDER_ID=1cnQl2W3fb5BjMu5B1Xp_Lh8ZZbjv3vkM
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:4000/api/v1/integrations/google-drive/callback
GOOGLE_DRIVE_SCOPE=https://www.googleapis.com/auth/drive.file

# --- TRANSACTIONAL EMAIL & PHPMAILER (SMTP) ---
# Supported providers: Gmail (smtp.gmail.com), Zoho, Brevo, SendGrid, Amazon SES, Custom SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=srenterprises02015@gmail.com
SMTP_PASS=
SMTP_FROM_EMAIL=srenterprises02015@gmail.com
SMTP_FROM_NAME=SR Enterprises
SUPPORT_EMAIL=srenterprises02015@gmail.com
SUPPORT_PHONE=+91 97660 39197
SMTP_DEBUG=false

